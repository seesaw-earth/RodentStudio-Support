      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A head poke—nose into the light compartment while the body remains in the dark—is a risk-assessment behavior requiring separate nose and body landmarks."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "身体留在暗箱、只把头伸进明箱的“探头”是典型的风险评估行为，需要把鼻尖和身体分开判断。"
          }
        }
      }
    },
