    "调整区域 / 阈值" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjust regions / thresholds"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调整区域 / 阈值"
          }
        }
      }
    },
    "质心追踪只知道动物“在哪里”。鼻尖、两耳、颈部、身体中心和尾根六个关键点还能回答“朝向哪里、在做什么”：嗅探与探索、头朝向、风险评估姿势、转圈和僵直。下面的范式参考文献中的常用定义实现，所有阈值都可以调整。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Centroid tracking tells you where an animal is. Six landmarks—nose, ears, neck, body center and tail base—also help estimate its orientation and actions, including investigation, risk assessment, turning and immobility. These assays use literature-inspired definitions with adjustable thresholds."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "质心追踪只知道动物“在哪里”。鼻尖、两耳、颈部、身体中心和尾根六个关键点还能回答“朝向哪里、在做什么”：嗅探与探索、头朝向、风险评估姿势、转圈和僵直。下面的范式参考文献中的常用定义实现，所有阈值都可以调整。"
          }
        }
      }
    },
    "质心追踪只能判断动物在哪个箱室。真正的社交接触是鼻尖贴近杯子并朝向它。RodentStudio 用鼻尖到杯子的距离加头朝向判定嗅探，并排除爬到杯子上的帧，更接近人工计分。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Centroid tracking shows chamber position, not investigation. RodentStudio combines nose-to-cup distance and head orientation, excluding frames with the body on the cup, to approximate manually scored cup investigation."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "质心追踪只能判断动物在哪个箱室。真正的社交接触是鼻尖贴近杯子并朝向它。RodentStudio 用鼻尖到杯子的距离加头朝向判定嗅探，并排除爬到杯子上的帧，更接近人工计分。"
          }
        }
      }
    },
